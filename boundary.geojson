fetch("./boundary.geojson")
  .then(response => {
    if (!response.ok) throw new Error("Không tải được boundary.geojson");
    return response.json();
  })
  .then(data => {
    L.geoJSON(data, {
      style: {
        color: "#FFD700",
        weight: 3,
        opacity: 1,
        fill: false,
        fillOpacity: 0
      }
    }).addTo(map);
  })
  .catch(error => console.error("Lỗi ranh giới:", error));
